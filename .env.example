# ─────────────────────────────────────────────────────────────
# CREO — cinematic AI launchpad. Environment variables.
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- AI generation (server-side only) ---
# CREO turns one sentence into a full launch package via an LLM.
# Provider: "bankr" (default) or "anthropic". Auto-detects from whichever key
# is set; force it with AI_PROVIDER.
AI_PROVIDER=bankr

# Bankr LLM Gateway powers EVERYTHING (text + images). One key routes across
# Bankr's many models. Create a key with "LLM Gateway" enabled at
# https://bankr.bot/api-keys and top up credits.
BANKR_API_KEY=
BANKR_MODEL=claude-sonnet-5
# BANKR_IMAGE_MODEL=gpt-image-1          # Bankr image model for token art
# BANKR_BASE_URL=https://llm.bankr.bot   # override only if needed

# Anthropic direct (optional text fallback only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- AI images ---
# Preferred: FLUX.1 [schnell] on fal.ai — best-looking stylized token art.
# Get a key at fal.ai; it's tried first for every image when set.
FAL_KEY=
# Fallbacks (used when FAL_KEY is unset): token art is generated through the
# SAME Bankr key above (BANKR_IMAGE_MODEL), or any other OpenAI-compatible
# images endpoint below; otherwise the icon falls back to a deterministic SVG
# so the studio still runs.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024   # optional; defaults to 512 (icon) / 1024 (photo)

# --- Image storage (token logo uploads → shown in the feed) ---
# Vercel KV (Storage tab) sets KV_REST_API_URL / KV_REST_API_TOKEN.
# An Upstash Redis marketplace integration sets the UPSTASH_* pair instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Wallet (mobile connect) ---
# WalletConnect Project ID (free at cloud.reown.com). Without it, MetaMask,
# Coinbase Wallet and injected/browser wallets still work; adding it enables the
# WalletConnect QR + more mobile wallets.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Chain / explorer (public, safe to expose) ---
# Arc mainnet (Circle). Defaults are baked into src/lib/chain.ts; override only
# to point at a paid RPC. Native gas currency on Arc is USDC.
NEXT_PUBLIC_CHAIN_ID=5042
# drpc answers reads + broadcasts reliably (arc-scan fails eth_call). Use a paid
# RPC here in production for best reliability.
NEXT_PUBLIC_RPC_URL=https://arc.drpc.org
NEXT_PUBLIC_EXPLORER_URL=https://arc-scan.org

# --- o1 metadata pinning (server-side; REQUIRED for logos/descriptions on o1) ---
# o1.exchange only renders a launch's logo/description/links when the metadata
# is pinned in o1's own Pinata. Without a key, tokens launched here still deploy
# but appear blank on o1.exchange. Get a key from o1, then set:
O1_API_KEY=
# Defaults to o1's production API; override only if o1 changes it.
O1_API_URL=https://api.launch.o1.exchange/v1

# --- (Optional) Analytics via Dune ---
# When set, /analytics fills volume / trades / revenue from Dune. Without it,
# those show "—" and only launches + unique devs (indexed from CREO) appear.
# Create a key at dune.com/settings/api, then point each var at a saved query id.
DUNE_API_KEY=
# Query returning ONE row of all-time totals. Recognized columns (any subset):
#   volume_usd, trades, protocol_revenue_usd, creator_earnings_usd,
#   launches, unique_devs
DUNE_QUERY_ALLTIME=
# Same one-row shape but for the latest 24h.
DUNE_QUERY_24H=
# Optional daily series: rows of { day (date), launches } for the launches chart.
DUNE_QUERY_SERIES=
